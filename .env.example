# Copia pública de ejemplo (SÍ se sube a GitHub).
# Copiar como `.env` y ajustar valores reales localmente:
#   copy .env.example .env   (Windows)
#   cp .env.example .env      (Linux/Mac)

MONGO_URI=mongodb://localhost:27017/automoviles
MONGO_DB=automoviles
MONGO_COLLECTION=vehiculos

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://default:<password>@<host>:<puerto>

FLASK_PORT=5000
FLASK_DEBUG=true

CAMPO_IDENTIFICADOR=categoria
CACHE_KEY_PREFIX=vehiculo:
