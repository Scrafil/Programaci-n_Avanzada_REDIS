      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/vehiculos/Barco",
        "description": "Int.2: tras el PUT el GET es MISS (mongodb) con el peso nuevo 2.5 = cache invalidado."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
