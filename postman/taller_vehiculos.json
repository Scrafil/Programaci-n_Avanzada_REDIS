        ],
        "url": "{{base_url}}/vehiculos/Barco",
        "description": "Int.2 invalidacion: actualiza peso 2 -> 2.5 y hace DEL vehiculo:Barco en Redis.",
        "body": {
          "mode": "raw",
          "raw": "{\"categoria\": \"Acuático\", \"peso_toneladas\": 2.5, \"descripcion\": \"Embarcación pequeña usada en ríos o mares.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
