              "    var json = pm.response.json();",
              "    pm.expect(json.fuente).to.eql(\"mongodb\");",
              "    pm.expect(json.peso_toneladas).to.eql(2.5);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
